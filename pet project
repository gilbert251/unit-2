class Hero:                                  # 1. the class name (Capitalized)
    def __init__(self, name, money, hp=100): # 2. setup method, runs on creation
        self.name = name                     # 3. attributes saved on "self"
        self.money = money
        self.hp = hp

    def potion(self):                        # 4. a method - always takes self first
        self.hp += 10

